{
  "schema_version": 1,
  "status": "research_contract_not_yet_runtime_patched",
  "guards": {
    "max_generation_depth": 12,
    "max_events_per_root_trigger": 4096
  },
  "rng": {
    "algorithm": "stable_hash_reference_only",
    "runtime_target": "native RandomStream",
    "child_seed_components": [
      "parent_seed",
      "modifier_instance_id",
      "child_index",
      "event_kind"
    ]
  },
  "hit_model_resolver": {
    "preserve_native_unless_required": true,
    "conversions": [
      {
        "when": {
          "source_hit_type": "EHitType::Raycast",
          "requires_effect": "Homing"
        },
        "target_hit_type": "EHitType::Projectile",
        "reason": "Homing requires projectile travel. BP_WA_Homing advertises Projectile and Raycast affected hit types, but shipped Seeker eligibility is projectile-only.",
        "preserve": [
          "damage",
          "firerate",
          "effective_range",
          "recoil",
          "muzzle_vfx",
          "sound",
          "critical_semantics"
        ],
        "requires_runtime_validation": true
      }
    ]
  },
  "effects": {
    "Bounce": {
      "row_ids": ["Bounce"],
      "display_name": "Bounce",
      "role": "traversal",
      "native_blueprint": "/Game/Blueprint/Weapon/Affixes/Prefab/BP_WA_Bounce.BP_WA_Bounce_C",
      "native_hit_types_observed": ["EHitType::Projectile", "EHitType::Raycast"],
      "stacking": {
        "mode": "add_native_parameter",
        "parameter": "BounceAmount"
      },
      "inherits_into": ["duplicate_shot", "pellet", "fragment", "ricochet_hit", "alt_fire_projectile"],
      "spawns_children": false
    },
    "Pierce": {
      "row_ids": ["Pierce"],
