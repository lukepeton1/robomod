      "stacking": {
        "mode": "native_budget",
        "parameter": "pierce_count_or_equivalent_runtime_state",
        "requires_runtime_validation": true
      },
      "inherits_into": ["duplicate_shot", "pellet", "fragment", "ricochet_hit", "alt_fire_projectile"],
      "spawns_children": false
    },
    "Homing": {
      "row_ids": ["Homing"],
