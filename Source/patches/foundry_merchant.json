{
  "schema_version": 1,
  "name": "weapon-foundry-merchant",
  "target": "Blueprint/Interactive/Merchant/BP_Merchant_UpgradeAffix",
  "status": "production",
  "purpose": "Seed the vanilla Perfumer/affix merchant with only globally safe, pairwise conflict-free ordinary Foundry affixes. Target-specific or mutually exclusive transferable rows remain reserved for deterministic GRAFT/Smith, which validates the actual target weapon before mutation.",
  "policy": {
    "full_transferable_affix_count": 50,
    "chassis_safe_candidate_count": 17,
    "global_merchant_affix_count": 14,
    "minimum_vanilla_weapon_coverage": 74,
    "explicit_generalized_rows_allowed": [
      "AutoShotgun",
      "Bounce",
      "ExplosiveBlank",
      "Fragmentation",
      "FreeShot",
      "Pierce",
      "Ricochet"
    ],
    "excluded_global_conflict_rows": [
      "BossDamage",
      "FlyDamage",
      "TurretDamage"
    ],
    "excluded_global_conflict_pairs": [
      [
        "BossDamage",
        "FlyDamage"
      ],
      [
        "BossDamage",
        "TurretDamage"
      ],
      [
        "FlyDamage",
        "TurretDamage"
      ]
    ]
  },
  "operations": [
    {
      "op": "set_name_array",
      "cdo": "Default__BP_Merchant_UpgradeAffix_C",
      "field": "AffixRows",
      "values": [
        "AutoCritical",
        "AutoShotgun",
        "Bounce",
        "Burn",
        "ExplosiveBlank",
        "Firerate",
        "Fragmentation",
        "FreeShot",
        "Ice",
        "Impact",
        "MarkDamage",
        "Pierce",
        "Ricochet",
        "Shock"
      ]
    }
  ]
}
